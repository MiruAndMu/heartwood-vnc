{
  "name": "heartwood-vnc",
  "productName": "Heartwood VNC",
  "version": "1.0.0",
  "description": "Heartwood VNC \u2014 your Mac, framed on your PC. A living window in handcrafted wood.",
  "main": "main.js",
  "scripts": {
    "check": "node --check main.js && node --check preload.js && node tests/release-smoke.mjs",
    "inspect:dist": "node tests/inspect-asar.mjs",
    "test:bridge": "python3 tests/test-vnc-bridge.py",
    "start": "electron .",
    "dist": "npm run check && electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.miruandmu.heartwood-vnc",
    "productName": "Heartwood VNC",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "novnc/**",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "HeartwoodVNC-${version}.exe"
    }
  },
  "author": "Mugen Styles & Miru Sou",
  "license": "MIT"
}
